# Katipuneros Library Store -- Environment Template
# Copy to `.env` and fill in real values. `.env` is git-ignored and must NEVER be committed.
#
#   cp .env.example .env
#
# NOTE: The .NET backend does not read this file directly. It reads secrets from
# `dotnet user-secrets` (dev) or environment variables (Render/prod).
# See AGENTS.md -> "SECRETS MANAGEMENT" for the per-environment commands.

# ─── Google SMTP (transactional email) ───────────────────────────────────
GMAIL_USER=you@gmail.com
GMAIL_APP_NAME="Project Katipuneros Book Store"
GMAIL_APP_PASSWORD="<16-char google-app-password>"

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS="<16-char google-app-password>"
SMTP_SENDER_NAME="Project Katipuneros Book Store"

# ─── Frontend ────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api
VITE_CORE_SYNC_INTERVAL_MS=15000
