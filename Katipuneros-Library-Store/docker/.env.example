# Katipuneros Library Store -- local 8-layer stack secrets.
# Copy to `docker/.env` and fill in. `docker/.env` is git-ignored.
#
#     cp docker/.env.example docker/.env
#
# Generate the two signing keys:
#     openssl rand -base64 48   # JWT_SECRET_KEY
#     openssl rand -base64 32   # ALTCHA_HMAC_SECRET

# ─── PostgreSQL ──────────────────────────────────────────────────────────
POSTGRES_DB=KatipunerosLibraryDb
POSTGRES_USER=katipuneros_admin
POSTGRES_PASSWORD=<choose-a-strong-password>
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=<choose-a-different-strong-password>

# ─── Redis ───────────────────────────────────────────────────────────────
REDIS_PASSWORD=<choose-a-strong-password>

# ─── Backend signing keys (REQUIRED -- the API will not boot without them) ─
JWT_SECRET_KEY=<openssl rand -base64 48>
ALTCHA_HMAC_SECRET=<openssl rand -base64 32>

# ─── SMTP (OPTIONAL -- email self-disables when unset) ───────────────────
SMTP_APP_PASSWORD=
SMTP_SENDER_EMAIL=library@localhost
