{
  // Katipuneros Library Store -- NON-SECRET baseline configuration.
  // Secrets are intentionally ABSENT. Supply them per environment:
  //   Development : dotnet user-secrets set "<Key>" "<Value>"
  //   Production  : environment variables, using '__' for ':'  (e.g. Jwt__SecretKey)
  // The app refuses to start when a required secret is missing. See AGENTS.md.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    // Local Windows-authenticated default. Contains NO credentials.
    // For SQL-auth dev machines, override via user-secrets:
    //   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "Server=localhost;Database=KatipunerosLibraryDb;User Id=<user>;Password=<pw>;TrustServerCertificate=True;"
    "DefaultConnection": "Server=localhost;Database=KatipunerosLibraryDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;"
  },

  "Jwt": {
    // SECRET -- provide via user-secrets or env var Jwt__SecretKey. Minimum 32 bytes.
    //   dotnet user-secrets set "Jwt:SecretKey" "$(openssl rand -base64 48)"
    "SecretKey": "",
    "Issuer": "KatipunerosLibraryApi",
    "Audience": "KatipunerosLibraryClient",
    "ExpiryHours": 24
  },

  "Altcha": {
    // SECRET -- HMAC key used to sign anti-bot Proof-of-Work challenges.
    //   dotnet user-secrets set "Altcha:HmacSecret" "$(openssl rand -base64 32)"
    "HmacSecret": ""
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },

  "LibraryPolicy": {
    "DefaultLoanDurationDays": 14,
    "MaxRenewalsAllowed": 2,
    "RenewalExtensionDays": 7,
    "DailyOverdueFineRate": 15.00,
    "MaximumFineCap": 500.00,
    "MaxActiveBorrowingsPerPatron": 3,
    // Collection valuation is reported as zero unless an explicit acquisition rate
    // is supplied. The Book entity stores no cost, so any default here would be an
    // invented financial figure.
    "ValuationPerCopy": 0.00
  },

  "SmtpSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "SenderEmail": "",
    "SenderName": "Project Katipuneros Book Store",
    // SECRET -- Google App Password. When empty, transactional email disables itself.
    //   dotnet user-secrets set "SmtpSettings:AppPassword" "<16-char-app-password>"
    "AppPassword": ""
  }
}
