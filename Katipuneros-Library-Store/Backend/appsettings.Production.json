{
  // Katipuneros Library Store -- PRODUCTION configuration. Contains NO secrets.
  // Every secret is injected by the platform (Render / Kubernetes) as an environment
  // variable using '__' in place of ':'. Examples:
  //   ConnectionStrings__PrimaryConnection
  //   Jwt__SecretKey
  //   Altcha__HmacSecret
  //   Redis__ConnectionString
  //   SmtpSettings__AppPassword
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // SECRET (both) -- supplied via environment variable on the hosting platform.
    "PrimaryConnection": "",
    "ReplicaConnection": ""
  },
  "Redis": {
    // SECRET -- supplied via environment variable. Leave empty to run without Redis.
    "ConnectionString": ""
  },
  "Jwt": {
    // SECRET -- supplied via environment variable Jwt__SecretKey.
    "SecretKey": "",
    "Issuer": "KatipunerosLibraryApi",
    "Audience": "KatipunerosLibraryClient",
    "ExpiryHours": 24
  },
  "Altcha": {
    // SECRET -- supplied via environment variable Altcha__HmacSecret.
    "HmacSecret": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "https://library.local",
      "https://customer.library.local",
      "https://cashier.library.local",
      "https://admin.library.local"
    ]
  }
}
